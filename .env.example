# Frontend (Vite) — copy to .env.local
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1
VITE_USE_FIREBASE_EMULATORS=false
# Local uploads without CORS errors: run `cd functions && npm run serve`, then:
# VITE_UPLOAD_USE_VITE_PROXY=true
# VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
# VITE_FUNCTIONS_EMULATOR_PORT=5001
# R2 (browser-safe only — never VITE_R2_ACCESS_KEY_ID / VITE_R2_SECRET_ACCESS_KEY)
VITE_R2_ACCOUNT_ID=45b20d97ffbad9e7a7573c735af61f19
VITE_R2_BUCKET_NAME=lms-portal
# Copy from your LMS / AddCourse project (required for stable chat image URLs):
# VITE_R2_PUBLIC_URL=https://your-existing-r2-public-host
# Local uploads: run `npx firebase-tools emulators:start --only functions` (proxy is on by default in dev)
# VITE_UPLOAD_USE_VITE_PROXY=false
VITE_COMPANY_TIMEZONE=Asia/Kolkata

# Do NOT put R2 access keys in Vite (VITE_*). They are bundled into the browser.
# Chat uploads use Cloud Functions + presigned URLs only.

# Cloud Functions — copy non-secrets to functions/.env.internal-chat-bc793
# Cloud Functions (Firebase environment config / Secret Manager)
# firebase functions:secrets:set R2_ACCESS_KEY_ID
# firebase functions:secrets:set R2_SECRET_ACCESS_KEY
R2_ACCOUNT_ID=
R2_BUCKET_NAME=lms-portal
# Folder inside the bucket (not a separate bucket)
R2_OBJECT_PREFIX=zuvius-internal
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ALLOWED_EMAIL_DOMAIN=zuvius.com
FUNCTIONS_REGION=asia-south1
