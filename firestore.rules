rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profileIsActive(data) {
      return !data.keys().hasAny(['isActive']) || data.isActive == true;
    }

    function isActiveUser() {
      return isSignedIn()
        && profileIsActive(userDoc().data);
    }

    function role() {
      return userDoc().data.role;
    }

    function hasMinRole(minRole) {
      let ranks = {
        'member': 1,
        'department_admin': 2,
        'admin': 3,
        'super_admin': 4
      };
      return ranks[role()] >= ranks[minRole];
    }

    function isAdmin() {
      return hasMinRole('admin');
    }

    function actorDepartmentIds() {
      return userDoc().data.keys().hasAny(['departmentIds'])
        ? userDoc().data.departmentIds
        : [];
    }

    function inDepartments(deptId) {
      return deptId != null && actorDepartmentIds().hasAny([deptId]);
    }

    function isDepartmentAdminFor(deptId) {
      return deptId != null
        && exists(/databases/$(database)/documents/departments/$(deptId))
        && (
          inDepartments(deptId)
          || get(/databases/$(database)/documents/departments/$(deptId)).data.adminIds.hasAny([request.auth.uid])
        );
    }

    // Department admin may view members assigned to departments they manage (profile or adminIds).
    function userManagedByDeptAdmin() {
      return resource.data.departmentIds.size() > 0
        && (
          isDepartmentAdminFor(resource.data.departmentIds[0])
          || (resource.data.departmentIds.size() > 1
            && isDepartmentAdminFor(resource.data.departmentIds[1]))
          || (resource.data.departmentIds.size() > 2
            && isDepartmentAdminFor(resource.data.departmentIds[2]))
          || (resource.data.departmentIds.size() > 3
            && isDepartmentAdminFor(resource.data.departmentIds[3]))
          || (resource.data.departmentIds.size() > 4
            && isDepartmentAdminFor(resource.data.departmentIds[4]))
        );
    }

    match /users/{userId} {
      // Collection queries (departmentIds, isActive, etc.) cannot use rules that exclude
      // the caller's own doc — split list vs get. Each result is still checked with get.
      allow list: if isActiveUser();

      allow get: if isSignedIn() && request.auth.uid == userId;
      allow get: if isActiveUser() && isAdmin();
      allow get: if isActiveUser() && request.auth.uid != userId
        && hasMinRole('department_admin')
        && profileIsActive(resource.data)
        && (
          resource.data.departmentIds.hasAny(actorDepartmentIds())
          || userManagedByDeptAdmin()
        );

      // Colleague directory (DM, task forwarding). Inactive profiles allowed on get; app filters.
      allow get: if isActiveUser() && request.auth.uid != userId;

      allow create: if isActiveUser() && isAdmin()
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role is string
        && request.resource.data.departmentIds is list
        && request.resource.data.isActive == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !(request.resource.data.role == 'super_admin' && role() != 'super_admin');

      allow update: if isActiveUser() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'displayName', 'photoURL', 'photoUploadId', 'phone', 'fcmTokens', 'updatedAt'
        ]);

      allow update: if isActiveUser() && isAdmin()
        && !(request.resource.data.role == 'super_admin' && role() != 'super_admin')
        && request.resource.data.diff(resource.data).changedKeys().hasAll(['updatedAt']);

      allow delete: if false;
    }

    match /departments/{departmentId} {
      // Org structure (names, memberIds) is visible to all active users for messaging and task forwarding.
      allow read: if isActiveUser();

      allow create: if isActiveUser() && isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.adminIds is list
        && request.resource.data.memberIds is list
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isActiveUser() && isAdmin()
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isActiveUser() && (
        isAdmin()
        || request.auth.uid in resource.data.memberIds
        || (resource.data.isDepartmentChannel == true
          && resource.data.departmentId != null
          && (
            inDepartments(resource.data.departmentId)
            || isDepartmentAdminFor(resource.data.departmentId)
          ))
      );

      allow create: if isActiveUser()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid
        && (
          (request.resource.data.type == 'group'
            && request.resource.data.isDepartmentChannel == true
            && isAdmin()
            && request.resource.data.memberIds.size() >= 1)
          || (request.resource.data.memberIds.size() >= 2
            && (
              (request.resource.data.type == 'direct'
                && request.resource.data.memberIds.size() == 2)
              || (request.resource.data.type == 'group'
                && (
                  request.resource.data.isDepartmentChannel != true
                  || isAdmin()
                  || (hasMinRole('department_admin')
                    && request.resource.data.departmentId != null
                    && inDepartments(request.resource.data.departmentId))
                ))
            ))
        );

      allow update: if isActiveUser() && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'updatedAt', 'title', 'description', 'imageURL'
        ]);

      allow update: if isActiveUser() && resource.data.isDepartmentChannel == true
        && (
          isAdmin()
          || (hasMinRole('department_admin')
            && resource.data.departmentId != null
            && inDepartments(resource.data.departmentId))
        )
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'memberIds', 'updatedAt', 'title'
        ]);

      // Join your department team chat when your profile lists that department.
      allow update: if isActiveUser()
        && resource.data.isDepartmentChannel == true
        && resource.data.departmentId != null
        && inDepartments(resource.data.departmentId)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'memberIds', 'updatedAt'
        ]);

      match /messages/{messageId} {
        allow read: if isActiveUser() && (
          isAdmin()
          || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
        );
        allow create: if isActiveUser()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if isActiveUser()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['text', 'editedAt', 'deletedAt']);
        allow delete: if false;
      }

      match /reads/{readerId} {
        allow read: if isActiveUser() && (
          isAdmin()
          || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
        );
        allow create, update: if isActiveUser()
          && request.auth.uid == readerId
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
          && request.resource.data.keys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt == request.time;
        allow delete: if false;
      }
    }

    match /tasks/{taskId} {
      function taskDoc() {
        return get(/databases/$(database)/documents/tasks/$(taskId));
      }

      function taskData() {
        return taskDoc().data;
      }

      function canReadTask() {
        return isActiveUser() && (
          isAdmin() ||
          resource.data.createdBy == request.auth.uid ||
          request.auth.uid in resource.data.assigneeIds ||
          (resource.data.keys().hasAny(['formerAssigneeIds'])
            && resource.data.formerAssigneeIds.hasAny([request.auth.uid])) ||
          (hasMinRole('department_admin')
            && resource.data.departmentId != null
            && isDepartmentAdminFor(resource.data.departmentId))
        );
      }

      function taskExists() {
        return exists(/databases/$(database)/documents/tasks/$(taskId));
      }

      function canReadTaskById() {
        return isActiveUser() && taskExists() && (
          isAdmin() ||
          taskData().createdBy == request.auth.uid ||
          request.auth.uid in taskData().assigneeIds ||
          (taskData().keys().hasAny(['formerAssigneeIds'])
            && taskData().formerAssigneeIds.hasAny([request.auth.uid])) ||
          (hasMinRole('department_admin')
            && taskData().departmentId != null
            && isDepartmentAdminFor(taskData().departmentId))
        );
      }

      function canAssignTasks() {
        return isActiveUser() && hasMinRole('department_admin');
      }

      function canCreateTasks() {
        return isActiveUser();
      }

      function userProfileActive(userId) {
        return exists(/databases/$(database)/documents/users/$(userId))
          && (
            !get(/databases/$(database)/documents/users/$(userId)).data.keys().hasAny(['isActive'])
            || get(/databases/$(database)/documents/users/$(userId)).data.isActive == true
          );
      }

      function assigneeEligibleForDept(assigneeId, deptId) {
        return userProfileActive(assigneeId)
          && get(/databases/$(database)/documents/users/$(assigneeId)).data.departmentIds.hasAny([deptId])
          && get(/databases/$(database)/documents/users/$(assigneeId)).data.role != 'admin'
          && get(/databases/$(database)/documents/users/$(assigneeId)).data.role != 'super_admin';
      }

      function assigneeEligibleForOrgHandover(assigneeId) {
        return userProfileActive(assigneeId);
      }

      function assigneesValidForOrgHandover(ids) {
        return ids.size() > 0
          && ids.size() <= 15
          && (ids.size() < 1 || assigneeEligibleForOrgHandover(ids[0]))
          && (ids.size() < 2 || assigneeEligibleForOrgHandover(ids[1]))
          && (ids.size() < 3 || assigneeEligibleForOrgHandover(ids[2]))
          && (ids.size() < 4 || assigneeEligibleForOrgHandover(ids[3]))
          && (ids.size() < 5 || assigneeEligibleForOrgHandover(ids[4]))
          && (ids.size() < 6 || assigneeEligibleForOrgHandover(ids[5]))
          && (ids.size() < 7 || assigneeEligibleForOrgHandover(ids[6]))
          && (ids.size() < 8 || assigneeEligibleForOrgHandover(ids[7]))
          && (ids.size() < 9 || assigneeEligibleForOrgHandover(ids[8]))
          && (ids.size() < 10 || assigneeEligibleForOrgHandover(ids[9]))
          && (ids.size() < 11 || assigneeEligibleForOrgHandover(ids[10]))
          && (ids.size() < 12 || assigneeEligibleForOrgHandover(ids[11]))
          && (ids.size() < 13 || assigneeEligibleForOrgHandover(ids[12]))
          && (ids.size() < 14 || assigneeEligibleForOrgHandover(ids[13]))
          && (ids.size() < 15 || assigneeEligibleForOrgHandover(ids[14]));
      }

      function assigneesValidForDept(deptId, ids) {
        return ids.size() > 0
          && ids.size() <= 15
          && (ids.size() < 1 || assigneeEligibleForDept(ids[0], deptId))
          && (ids.size() < 2 || assigneeEligibleForDept(ids[1], deptId))
          && (ids.size() < 3 || assigneeEligibleForDept(ids[2], deptId))
          && (ids.size() < 4 || assigneeEligibleForDept(ids[3], deptId))
          && (ids.size() < 5 || assigneeEligibleForDept(ids[4], deptId))
          && (ids.size() < 6 || assigneeEligibleForDept(ids[5], deptId))
          && (ids.size() < 7 || assigneeEligibleForDept(ids[6], deptId))
          && (ids.size() < 8 || assigneeEligibleForDept(ids[7], deptId))
          && (ids.size() < 9 || assigneeEligibleForDept(ids[8], deptId))
          && (ids.size() < 10 || assigneeEligibleForDept(ids[9], deptId))
          && (ids.size() < 11 || assigneeEligibleForDept(ids[10], deptId))
          && (ids.size() < 12 || assigneeEligibleForDept(ids[11], deptId))
          && (ids.size() < 13 || assigneeEligibleForDept(ids[12], deptId))
          && (ids.size() < 14 || assigneeEligibleForDept(ids[13], deptId))
          && (ids.size() < 15 || assigneeEligibleForDept(ids[14], deptId));
      }

      function canModifyTask() {
        return isAdmin()
          || request.auth.uid in resource.data.assigneeIds
          || resource.data.createdBy == request.auth.uid
          || (hasMinRole('department_admin')
            && resource.data.departmentId != null
            && isDepartmentAdminFor(resource.data.departmentId));
      }

      function canDeleteTaskDoc() {
        return isActiveUser() && canReadTask()
          && (resource.data.createdBy == request.auth.uid || isAdmin());
      }

      function canDeleteTaskSubdocs() {
        return isActiveUser() && taskExists() && canReadTaskById()
          && (taskData().createdBy == request.auth.uid || isAdmin());
      }

      // Department admins: list/query tasks for departments they manage.
      allow read: if isActiveUser()
        && hasMinRole('department_admin')
        && !isAdmin()
        && resource.data.departmentId != null
        && isDepartmentAdminFor(resource.data.departmentId);

      allow read: if canReadTask();

      allow create: if canCreateTasks()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.assigneeIds is list
        && request.resource.data.departmentId is string
        && request.resource.data.departmentId.size() > 0
        && assigneesValidForOrgHandover(request.resource.data.assigneeIds);

      allow update: if isActiveUser() && canReadTask()
        && request.auth.uid in resource.data.assigneeIds
        && role() == 'member'
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.departmentId == resource.data.departmentId
        && request.resource.data.assigneeIds == resource.data.assigneeIds
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status', 'updatedAt', 'completedAt', 'completionNotes'
        ]);

      allow update: if isActiveUser() && canReadTask()
        && request.auth.uid in resource.data.assigneeIds
        && resource.data.status != 'completed'
        && resource.data.status != 'cancelled'
        && !(request.auth.uid in request.resource.data.assigneeIds)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.departmentId == resource.data.departmentId
        && request.resource.data.assigneeIds.size() >= 1
        && assigneesValidForOrgHandover(request.resource.data.assigneeIds)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'assigneeIds', 'formerAssigneeIds', 'status', 'updatedAt'
        ]);

      allow delete: if canDeleteTaskDoc();

      allow update: if isActiveUser() && canReadTask()
        && canModifyTask()
        && !(role() == 'member' && request.auth.uid in resource.data.assigneeIds)
        && request.resource.data.createdBy == resource.data.createdBy
        && (isAdmin()
          || request.resource.data.departmentId == resource.data.departmentId)
        && (isAdmin()
          || request.resource.data.assigneeIds == resource.data.assigneeIds
          || assigneesValidForDept(
            request.resource.data.departmentId,
            request.resource.data.assigneeIds))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'title', 'description', 'departmentId', 'assigneeIds', 'priority', 'status',
          'deadlineAt', 'startAt', 'requiresReview', 'category', 'attachmentIds',
          'formerAssigneeIds', 'updatedAt', 'completedAt', 'completionNotes'
        ]);

      match /history/{eventId} {
        allow read: if canReadTaskById();
        allow create: if isActiveUser()
          && taskExists()
          && request.resource.data.taskId == taskId
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (canReadTaskById()
            || taskData().createdBy == request.auth.uid
            || canAssignTasks());
        allow update: if false;
        allow delete: if canDeleteTaskSubdocs();
      }

      match /assignees/{assigneeId} {
        allow read: if canReadTaskById();

        allow create: if taskExists()
          && request.resource.data.status is string
          && request.resource.data.progress is number
          && request.resource.data.updatedAt == request.time
          && (
            (assigneeId in taskData().assigneeIds
              && (canAssignTasks()
                || taskData().createdBy == request.auth.uid
                || request.auth.uid in taskData().assigneeIds))
            || (request.auth.uid in taskData().assigneeIds
              && assigneeEligibleForOrgHandover(assigneeId)
              && request.resource.data.status == 'todo')
          );

        allow update: if isActiveUser() && assigneeId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'status', 'progress', 'completionNotes', 'completedAt', 'updatedAt'
          ]);

        allow delete: if canDeleteTaskSubdocs();
      }

      match /comments/{commentId} {
        allow read: if canReadTaskById();
        allow create: if canReadTaskById()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.createdAt == request.time;
        allow delete: if canDeleteTaskSubdocs();
      }
    }

    match /notifications/{notificationId} {
      allow read: if isActiveUser() && resource.data.recipientId == request.auth.uid;
      allow update: if isActiveUser()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['readAt']);
      allow create: if isActiveUser()
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.entityType == 'task'
        && request.resource.data.readAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string
        && request.resource.data.body is string
        && exists(/databases/$(database)/documents/tasks/$(request.resource.data.entityId))
        && (
          (request.resource.data.type == 'task_completed'
            && exists(/databases/$(database)/documents/tasks/$(request.resource.data.entityId)/assignees/$(request.auth.uid))
            && get(/databases/$(database)/documents/tasks/$(request.resource.data.entityId)/assignees/$(request.auth.uid)).data.status == 'completed')
          || (request.resource.data.type in ['task_forwarded', 'task_reassigned']
            && request.resource.data.handoverKey is string
            && exists(/databases/$(database)/documents/tasks/$(request.resource.data.entityId)/history/$(('forward-' + request.resource.data.handoverKey)))
            && get(/databases/$(database)/documents/tasks/$(request.resource.data.entityId)/history/$(('forward-' + request.resource.data.handoverKey))).data.actorId == request.auth.uid)
          || (request.resource.data.type == 'task_assigned'
            && exists(/databases/$(database)/documents/tasks/$(request.resource.data.entityId))
            && request.auth.uid in get(/databases/$(database)/documents/tasks/$(request.resource.data.entityId)).data.assigneeIds)
        );
      allow delete: if false;
    }

    match /activityLogs/{logId} {
      allow read: if isActiveUser() && hasMinRole('department_admin');
      allow write: if false;
    }

    match /uploads/{uploadId} {
      allow read: if isActiveUser() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      allow write: if false;
    }

    match /reminderEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
